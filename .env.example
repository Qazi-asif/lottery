# --- Supabase Postgres (required) ---
# Project Settings → Database → Connection string
#
# DATABASE_URL = Session pooler (port 5432) for Prisma Client.
# DIRECT_URL   = same session/direct string for Prisma migrate / seed.
# Avoid transaction pooler (6543 + pgbouncer=true) with Prisma — it adds ~1s per query.
#
# Replace PROJECT_REF, PASSWORD, and REGION (e.g. ap-south-1, closest to you).
# Password is the database password from Settings → Database (not the anon key).

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional dashboard values — Prisma does not use these.
# Auth is NextAuth, not Supabase Auth. Leave blank unless you add the JS client later.
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Stripe (Stage 3+)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Stage 3+)
RESEND_API_KEY=
